layout {
    pane size=1 borderless=true {
        plugin location="tab-bar"
    }
    pane split_direction="horizontal" {
      pane split_direction="vertical" size="60%" {
        pane {
          name "Lang: EQ"
          command "sh"
          args "watcher.sh" "eq-input"
        }
        pane {
          name "AST (based on ESTree Spec)"
          command "sh"
          args "watcher.sh" "c-run"
        }
        pane {
          name "Lang: JS"
          command "sh"
          args "watcher.sh" "js-output"
        }
      }
      pane split_direction="vertical" size="40%" {
        pane size="60%" {
          name "C Build"
          command "sh"
          args "watcher.sh" "c-build"
        }
        pane {
          name "JS Generate"
          command "sh"
          args "watcher.sh" "js-generate"
        }
      }
    }
    pane size=2 borderless=true {
        plugin location="status-bar"
    }
}
