{
  // General
  "editor.indentSize": 2,
  "editor.tabSize": 2,
  "editor.formatOnSave": true,
  "files.eol": "\n",
  "files.encoding": "utf8",
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  // Extensions
  "javascript.preferences.quoteStyle": "single",
  "javascript.format.semicolons": "insert",
  "javascript.format.enable": true,
  "js/ts.implicitProjectConfig.checkJs": true,
  "C_Cpp.default.compileCommands": "build/compile_commands.json",
  "cmake.debugConfig": {
    "cwd": "${workspaceFolder}",
    "args": [
      "examples/playground.kapi",
    ],
  },
  "files.associations": {
    "string.h": "c",
    "__bit_reference": "c",
    "string": "c",
    "string_view": "c",
    "ios": "c",
    "types.h": "c",
    "token.h": "c",
    "parser.h": "c",
    "stddef.h": "c",
    "limits.h": "c",
    "climits": "c",
    "sstream": "c",
    "streambuf": "c",
    "ast.h": "c",
    "json.h": "c",
    "generator.h": "c",
    "typeinfo": "c"
  },
}
