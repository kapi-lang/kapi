# Dictionary

# Make sense have this?
var a: Dict = {};

# Make sense have this?
var a: Dict = {
  0 = true,
  name = "equal",
  age = 29,
};

# Async

struct Data {
  message: String;
}

enum Result {
  Ok(Int, Data),
  Error(Int, String)
}

async fn do_request(String url) Result {
  if (Task.cancelled) {
    return Result.Error(0, "Cancelled");
  }

  var data: Data = {
    message = "Success",
  };

  return Result.Ok(200, data);
}

var result: Task<Result> = do_request("url");

await result;   # Message
