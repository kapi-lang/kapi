{
  "quiet": true,
  "ignore": [
    "**/node_modules/**",
    "**/out/**"
  ],
  "watch": [
    "examples/",
    "src/",
    "rollup.config.mjs"
  ],
  "ext": "eq,mjs,js",
  "execMap": {
    "eq": "INPUT={{filename}} rollup -c"
  },
  "events": {
    "start": "node -e \"process.stdout.write('\u001Bc\u001B[3J');\""
  }
}
